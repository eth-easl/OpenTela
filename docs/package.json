{
  "name": "opentela-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build && node scripts/strip-vercel-og.mjs",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "upload": "npm run build:cf && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.16.3",
    "@types/mdx": "^2.0.13",
    "fumadocs-core": "^16.6.13",
    "fumadocs-mdx": "14.2.9",
    "fumadocs-ui": "^16.6.13",
    "lucide-react": "^1.23.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.74.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "fumadocs-mdx": {
      "esbuild": "^0.28.1"
    }
  }
}
